{
  "$schema": "https://opencode.ai/config.json",

  // Modello primario: Claude Haiku 5.5 via OpenRouter (array-agent: explorer/librarian/
  // observer/fixer/reviewer/verifier/looker). Passato da OpenCode Go a OpenRouter
  // dopo l'esaurimento della quota Go (saldo pay-per-use).
  // Ctx 1M, tool calling + vision. Fallback manuale via /models: `openrouter/z-ai/glm-5.3-flash`.
  "model": "openrouter/anthropic/claude-haiku-5.5",

  // Agente primario attivo all'avvio (TUI, run, desktop: vale ovunque)
  "default_agent": "orchestrator",

  // Override espliciti sulla variante OpenRouter di GLM 5.3 Flash — fallback manuale
  // pay-per-use (`openrouter/z-ai/glm-5.3-flash` quando la quota Go è finita).
  // Il resto dei modelli usa il registry models.dev: per `opencode-go/glm-5.3-flash`
  // i metadati limit/cost su models.dev sono già corretti, nessun override serve.
  // - limit: abilita auto-compaction corretta su sessioni repo-scale (finestra 1M)
  // - cost: listino first-party Z.AI su OpenRouter ($/M token), per statistiche accurate
  // - body: sampling consigliato Z.ai per coding agentico (benchmark NL2Repo: temp 1.0 / top_p 1.0)
  "providers": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": { "context": 1048576, "output": 131072 },
          "cost": { "input": 0.15, "output": 0.5, "cache": { "read": 0.03 } },
          "body": { "temperature": 1.0, "top_p": 1.0 }
        }
      }
    },
    // Claude Haiku 5.5 su OpenCode Go (modello primario e agenti): override esplicito
    // con i metadati di models.dev (verificati 2026-10-12). Tier cost >100k token omesso.
    "opencode-go": {
      "models": {
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "limit": { "context": 1000000, "output": 128000 },
          "cost": { "input": 0.1, "output": 0.5, "cache": { "read": 0.01, "write": 0.125 } }
        }
      }
    }
  },

  // Plugin: nessuno
  "plugins": [],

    // ⭐ MATRICE PERMESSI (pattern elithrar, sintassi V2: lista ordinata, vince l'ULTIMA regola che matcha)
    // Nota migrazione: la vecchia regola `doom_loop: ask` è stata rimossa perché `doom_loop` non è
    // un'azione di permesso V2 (vedi doc Permissions: "doom_loop and lsp are not current V2 Core permission actions").
  "permissions": [
    // Lettura: permesso di default, negazione per segreti
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.dev.vars", "effect": "deny" },
    { "action": "read", "resource": "**/*.dev.vars", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/*.env.example", "effect": "allow" },

    // Modifica file: permesso di default (copre anche write e patch).
    // Cross-platform: il matcher di opencode normalizza i percorsi (backslash -> slash)
    // prima del matching e "*" equivale a ".*" (include i separatori di percorso),
    // quindi la regola {action "edit", resource "*", effect "allow"} copre ogni file
    // identicamente su Windows e Linux, senza pattern specifici per piattaforma.
    { "action": "edit", "resource": "*", "effect": "allow" },

    // Shell: default ask + allowlist granulare a 6 tier
    { "action": "shell", "resource": "*", "effect": "ask" },
    // TIER 1: letture → allow (da storico sessioni: ls/grep/find/sed sono tra i comandi più usati)
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git remote *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "sed -n *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker images", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    // TIER 2: scritture sicure → allow
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "git push", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    // Sync config live <-> repo (rsync su Linux, robocopy su Windows; nessun commit automatico)
    { "action": "shell", "resource": "scripts/sync.sh *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/sync.ps1 *", "effect": "allow" },
    { "action": "shell", "resource": "/home/daniele/git/opencode-config/scripts/sync.sh *", "effect": "allow" },
    // Sync wiki ZD_evoDoc2 (mirror locale wiki-mirror/, git-ignored)
    { "action": "shell", "resource": "scripts/wiki-sync.ps1", "effect": "allow" },
    { "action": "shell", "resource": "scripts/wiki-sync.ps1 *", "effect": "allow" },
    { "action": "shell", "resource": "scripts/wiki-sync.sh *", "effect": "allow" },
    // TIER 3: irreversibili → ask (default, già sopra)
    // TIER 4: distruttivi → deny (vince l'ULTIMA regola che matcha: i narrow stanno dopo i broad)
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -f *", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fd *", "effect": "deny" },
    { "action": "shell", "resource": "gh release delete *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr delete *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item *-Recurse*", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item *-Force*", "effect": "deny" },
    // TIER 5: esecuzioni
    { "action": "shell", "resource": "dotnet *", "effect": "allow" },

    // TIER 6: cmdlet PowerShell — su Windows opencode esegue i comandi via pwsh,
    // quindi ogni cmdlet non presente qui matcha "*" e richiede conferma.
    // I cmdlet di pipeline hanno anche la forma bare: il pattern "X *" non
    // matcha il comando "X" senza argomenti (es. "... | ConvertTo-Json").
    // Letture (coerenti con read allow):
    { "action": "shell", "resource": "Get-Content *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Item *", "effect": "allow" },
    { "action": "shell", "resource": "Get-ChildItem *", "effect": "allow" },
    { "action": "shell", "resource": "Test-Path *", "effect": "allow" },
    { "action": "shell", "resource": "Select-String *", "effect": "allow" },
    { "action": "shell", "resource": "Select-Object", "effect": "allow" },
    { "action": "shell", "resource": "Select-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Measure-Object", "effect": "allow" },
    { "action": "shell", "resource": "Measure-Object *", "effect": "allow" },
    { "action": "shell", "resource": "Sort-Object", "effect": "allow" },
    { "action": "shell", "resource": "Sort-Object *", "effect": "allow" },
    { "action": "shell", "resource": "ConvertFrom-Json", "effect": "allow" },
    { "action": "shell", "resource": "ConvertFrom-Json *", "effect": "allow" },
    { "action": "shell", "resource": "ConvertTo-Json", "effect": "allow" },
    { "action": "shell", "resource": "ConvertTo-Json *", "effect": "allow" },
    // Mantieni il deny dei segreti anche da shell (allinea con read: *.env* deny)
    { "action": "shell", "resource": "Get-Content *.env*", "effect": "deny" },
    // Scritture file (coerenti con edit: allow)
    { "action": "shell", "resource": "Out-File *", "effect": "allow" },
    { "action": "shell", "resource": "Set-Content *", "effect": "allow" },
    { "action": "shell", "resource": "Add-Content *", "effect": "allow" },
    { "action": "shell", "resource": "New-Item *", "effect": "allow" },
    { "action": "shell", "resource": "Copy-Item *", "effect": "allow" },
    { "action": "shell", "resource": "Move-Item *", "effect": "allow" },
    // Rete: allineato a webfetch: allow. NB: Invoke-WebRequest può fare
    // POST verso host arbitrari (esfiltrazione); per massima sicurezza: "ask".
    { "action": "shell", "resource": "Invoke-WebRequest *", "effect": "allow" },

    // Sandbox: solo nelle directory di lavoro
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/git/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },

    // Web e accesso remoto
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],

  // Agenti built-in disabilitati (sostituiti da agents/*.md)
  // title: modello economico per task leggeri (title, summary, compaction).
  // DeepSeek V4 Flash su Go — $0.14 in / $0.28 out per M token (vs ~$0.18 out blended
  // del vecchio `openrouter/deepseek/deepseek-v4-flash-0731`); su Zen esistono anche
  // i free (mimo-v2.6-flash-free, ling-3.1-flash-free) ma scontati da rate-limit.
  // (già `small_model` in V1; in V2 è la selezione modello dell'agente title)
  "agents": {
    "explore": { "disabled": true },
    "general": { "disabled": true },
    "scout": { "disabled": true },
    "title": { "model": "opencode-go/deepseek-v4-flash" }
  },

  // Collegamento al file di regole contenuto nella cartella rules
  // Formato `~/` cross-platform: opencode espande `~` con os.homedir() (funziona
  // uguale su Linux e Windows, dove la config globale è comunque ~/.config/opencode).
  // NON usare path relativi (risolti dalla cwd del progetto) né path assoluti macchina-specifici.
  "instructions": [
    "~/.config/opencode/rules/rules.md",
    "~/.config/opencode/rules/evodoc.md"
  ],

  // Profondità nesting subagent: 1 = i subagent non spawnano altri subagent
  // (in v2 la chiave vive sotto `experimental`; top-level viene ignorata)
  "experimental": {
    "subagent_depth": 1
  },

  // LSP built-in
  "lsp": true,

  // Compaction automatica (riduce bisogno di plugin di context pruning)
  "compaction": {
    "auto": true
  },

  // File watcher ignore
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },

  // Undo/revert (utile per sicurezza) - chiave validata nello schema ufficiale
  "snapshots": true,

  // Sharing manuale
  "share": "manual",

  // Server MCP (Model Context Protocol)
  // RIMOSSI (zero invocazioni nello storico sessioni, verificato su opencode.db):
  // - with-context (33 tool): nessun uso
  // - filesystem (14 tool): duplica i tool nativi read/glob/grep
  // - sequential-thinking: nessun uso
  // - memory: nessun uso (i tool memory_* usati sono built-in di opencode)
  // - github: sostituito da `gh` CLI autenticata (allowlistata)
  "mcp": {}
}
