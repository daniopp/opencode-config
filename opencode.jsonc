{
  "$schema": "https://opencode.ai/config.json",

  // Modello primario (cascata su z-ai/glm-5.3-flash)
  "model": "inception/mercury-2.5-preview",

  // Modello economico per task leggeri
  "small_model": "openrouter/inclusionai/ling-3.0-flash",

  // Plugin: nessuno
  "plugin": [],

  // ⭐ MATRICE PERMESSI (pattern elithrar)
  "permission": {
    // Controllo loop infinito - ask invece di deny
    "doom_loop": "ask",

    // Lettura: permesso di default, negazione per segreti
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.dev.vars": "deny",
      "*.env.example": "allow"
    },

    // Modifica file: permesso di default (copre anche write e patch)
    "edit": {
      "*": "allow"
    },

    // Shell: default ask + allowlist granulare a 4 tier
    "bash": {
      "*": "ask",
      // TIER 1: letture → allow
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "grep *": "allow",
      "find *": "allow",
      // TIER 2: scritture sicure → allow
      "git add *": "allow",
      "git commit *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      // TIER 3: irreversibili → ask (default, già sopra)
      // TIER 4: distruttivi → deny
      "rm -rf *": "deny",
      "git reset --hard *": "deny",
      "git push --force *": "deny",
      "gh release delete *": "deny"
    },

    // Sandbox: solo nelle directory di lavoro
    "external_directory": {
      "*": "ask",
      "~/git/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    },

    // Web e accesso remoto
    "webfetch": "allow",
    "websearch": "allow"
  },

  // Agenti built-in disabilitati (sostituiti da agents/*.md)
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "scout": { "disable": true }
  },

  // Profondità nesting subagent: 1 = i subagent non spawnano altri subagent
  "subagent_depth": 1,

  // LSP built-in
  "lsp": true,

  // Compaction automatica (riduce bisogno di plugin di context pruning)
  "compaction": {
    "auto": true,
    "prune": true
  },

  // File watcher ignore
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },

  // Undo/revert (utile per sicurezza)
  "snapshot": true,

  // Sharing manuale
  "share": "manual",

  // Server MCP (Model Context Protocol)
  "mcp": {
    "with-context": {
      "type": "local",
      "command": [
        "/home/daniele/.nvm/versions/node/v24.18.0/bin/npx",
        "-y",
        "with-context-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "/home/daniele/.nvm/versions/node/v24.18.0/bin/npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/home/daniele/.nvm/versions/node/v24.18.0/bin/npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/daniele/git"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/daniele/.nvm/versions/node/v24.18.0/bin/npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "/home/daniele/.nvm/versions/node/v24.18.0/bin/npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    }
  }
}