# Variabili d'ambiente per SQL Server - repo-specific
# RINOMINA IN: .opencode/env.sh
# AGGIUNGI .opencode/env.sh al .gitignore del tuo repo!

# SQL Authentication
export MSSQL_SERVER="localhost"
export MSSQL_DATABASE="NomeDatabase"
export MSSQL_USER="username"
export MSSQL_PASSWORD="password"
export MSSQL_PORT="1433"
export MSSQL_ENCRYPT="true"

# Windows Authentication (alternativa)
# export MSSQL_WINDOWS_AUTH="true"
# export MSSQL_SERVER="localhost"
# export MSSQL_DATABASE="NomeDatabase"
