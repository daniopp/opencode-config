{
  "$schema": "https://opencode.ai/config.json",

  // Modello di default - cambia qui per usare un provider diverso
  "model": "opencode-go/kimi-k2.7-code",

  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        }
      }
    }
  },

  // Plugin installati
  "plugin": [
    "opencode-mem",
    "envsitter-guard"
  ],

  // LSP abilitati (Java, Go, C#, TS, ecc.)
  "lsp": true,

  // Permessi
  // edit: ask  -> conferma prima di modificare file (protezione codebase)
  // bash: allow -> comandi shell liberi (git, build, test, ecc.)
  // webfetch: allow -> lettura URL libera
  "permission": {
    "edit": "ask",
    "bash": "allow",
    "webfetch": "allow"
  },

  // MCP Server globali (sempre disponibili)
  "mcp": {
    // GitHub MCP - remote server ufficiale
    // Richiede autenticazione: opencode mcp auth github
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    }

    // Per aggiungere Context7 (richiede Node.js):
    // "context7": {
    //   "type": "local",
    //   "command": ["/percorso/assoluto/npx", "-y", "@upstash/context7-mcp"],
    //   "enabled": true
    // }
  },

  // Server web
  "server": {
    "hostname": "0.0.0.0",
    "port": 80
  }
}
