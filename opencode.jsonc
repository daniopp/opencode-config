{
  "$schema": "https://opencode.ai/config.json",

  // Modello primario: GLM 5.3 Flash — contesto 1M, multimodale (text+image), reasoning
  // Listino OpenRouter/Z.AI: $0.15 in / $0.50 out per M token, cache read $0.03
  "model": "openrouter/z-ai/glm-5.3-flash",

  // Modello economico per task leggeri (title, summary, compaction):
  // DeepSeek V4 Flash 0731 — $0.05 in / $0.16 out per M token, context 1M
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",

  // Override espliciti sul modello primario (il resto dei modelli usa il registry models.dev)
  // - limit: abilita auto-compaction corretta su sessioni repo-scale (finestra 1M)
  // - cost: listino first-party Z.AI su OpenRouter ($/M token), per statistiche accurate
  // - options: sampling consigliato Z.ai per coding agentico (benchmark NL2Repo: temp 1.0 / top_p 1.0)
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": { "context": 1048576, "output": 131072 },
          "cost": { "input": 0.15, "output": 0.5, "cache_read": 0.03 },
          "options": { "temperature": 1.0, "top_p": 1.0 }
        }
      }
    }
  },

  // Plugin: nessuno
  "plugin": [],

    // ⭐ MATRICE PERMESSI (pattern elithrar)
  "permission": {
    // Controllo loop infinito - ask invece di deny (chiave validata nello schema ufficiale)
    "doom_loop": "ask",

    // Lettura: permesso di default, negazione per segreti
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.dev.vars": "deny",
      "**/*.dev.vars": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow"
    },

    // Modifica file: permesso di default (copre anche write e patch)
    "edit": {
      "*": "allow"
    },

    // Shell: default ask + allowlist granulare a 4 tier
    "bash": {
      "*": "ask",
      // TIER 1: letture → allow (da storico sessioni: ls/grep/find/sed sono tra i comandi più usati)
      "git status": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sed -n *": "allow",
      "echo *": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker images": "allow",
      "docker logs *": "allow",
      "npx tsc *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      // TIER 2: scritture sicure → allow
      "git add *": "allow",
      "git commit *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "git push": "allow",
      "git push *": "allow",
      // Sync config live <-> repo (rsync, nessun commit automatico)
      "scripts/sync.sh *": "allow",
      "/home/daniele/git/opencode-config/scripts/sync.sh *": "allow",
      // TIER 3: irreversibili → ask (default, già sopra)
      // TIER 4: distruttivi → deny (vince l'ULTIMA regola che matcha: i narrow stanno dopo i broad)
      "rm -rf *": "deny",
      "git reset --hard *": "deny",
      "git push --force*": "deny",
      "git clean -f *": "deny",
      "git clean -fd *": "deny",
      "gh release delete *": "deny",
      "gh pr delete *": "deny",
	  //TIER 5: eseguzioni
	  "dotnet *" : "allow",
    },

    // Sandbox: solo nelle directory di lavoro
    "external_directory": {
      "*": "ask",
      "~/git/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    },

    // Web e accesso remoto
    "webfetch": "allow",
    "websearch": "allow"
  },

  // Agenti built-in disabilitati (sostituiti da agents/*.md)
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "scout": { "disable": true }
  },

  // Collegamento al file di regole contenuto nella cartella rules
  "instructions": [
    "C:/Users/daniele.oppezzo_smeu/.config/opencode/rules/rules.md"
  ],

  // Profondità nesting subagent: 1 = i subagent non spawnano altri subagent
  "subagent_depth": 1,

  // LSP built-in
  "lsp": true,

  // Compaction automatica (riduce bisogno di plugin di context pruning)
  "compaction": {
    "auto": true,
    "prune": true
  },

  // File watcher ignore
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },

  // Undo/revert (utile per sicurezza) - chiave validata nello schema ufficiale
  "snapshot": true,

  // Sharing manuale
  "share": "manual",

  // Server MCP (Model Context Protocol)
  // RIMOSSI (zero invocazioni nello storico sessioni, verificato su opencode.db):
  // - with-context (33 tool): nessun uso
  // - filesystem (14 tool): duplica i tool nativi read/glob/grep
  // - sequential-thinking: nessun uso
  // - memory: nessun uso (i tool memory_* usati sono built-in di opencode)
  // - github: sostituito da `gh` CLI autenticata (allowlistata)
  "mcp": {}
}