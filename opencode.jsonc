{
  "$schema": "https://opencode.ai/config.json",

  // Modello primario (cascata su z-ai/glm-5.3-flash)
  "model": "openrouter/inception/mercury-2.5",

  // Modello economico per task leggeri
  "small_model": "openrouter/z-ai/glm-5.3-flash",

  // Plugin: nessuno
  "plugin": [],

    // ⭐ MATRICE PERMESSI (pattern elithrar)
  "permission": {
    // Controllo loop infinito - ask invece di deny (chiave validata nello schema ufficiale)
    "doom_loop": "ask",

    // Lettura: permesso di default, negazione per segreti
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.dev.vars": "deny",
      "**/*.dev.vars": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow"
    },

    // Modifica file: permesso di default (copre anche write e patch)
    "edit": {
      "*": "allow"
    },

    // Shell: default ask + allowlist granulare a 4 tier
    "bash": {
      "*": "ask",
      // TIER 1: letture → allow (cat/grep/find/ls sono duplicati dei tool nativi, esclusi)
      "git status": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      // TIER 2: scritture sicure → allow
      "git add *": "allow",
      "git commit *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      // TIER 3: irreversibili → ask (default, già sopra)
      // TIER 4: distruttivi → deny
      "rm -rf *": "deny",
      "git reset --hard *": "deny",
      "git push --force *": "deny",
      "git clean -f *": "deny",
      "git clean -fd *": "deny",
      "gh release delete *": "deny",
      "gh pr delete *": "deny",
	  //TIER 5: eseguzioni
	  "dotnet *" : "allow",
    },

    // Sandbox: solo nelle directory di lavoro
    "external_directory": {
      "*": "ask",
      "~/git/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    },

    // Web e accesso remoto
    "webfetch": "allow",
    "websearch": "allow"
  },

  // Agenti built-in disabilitati (sostituiti da agents/*.md)
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "scout": { "disable": true }
  },

  // Collegamento al file di regole contenuto nella cartella rules
  "instructions": [
    "C:/Users/daniele.oppezzo_smeu/.config/opencode/rules/rules.md"
  ],

  // Profondità nesting subagent: 1 = i subagent non spawnano altri subagent
  "subagent_depth": 1,

  // LSP built-in
  "lsp": true,

  // Compaction automatica (riduce bisogno di plugin di context pruning)
  "compaction": {
    "auto": true,
    "prune": true
  },

  // File watcher ignore
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },

  // Undo/revert (utile per sicurezza) - chiave validata nello schema ufficiale
  "snapshot": true,

  // Sharing manuale
  "share": "manual",

  // Server MCP (Model Context Protocol)
  // RIMOSSI (zero invocazioni nello storico sessioni, verificato su opencode.db):
  // - with-context (33 tool): nessun uso
  // - filesystem (14 tool): duplica i tool nativi read/glob/grep
  // - sequential-thinking: nessun uso
  // - memory: nessun uso (i tool memory_* usati sono built-in di opencode)
  // - github: sostituito da `gh` CLI autenticata (allowlistata)
  "mcp": {}
}