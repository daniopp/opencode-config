# Variabili d'ambiente per MongoDB - repo-specific
# RINOMINA IN: .opencode/env.sh
# AGGIUNGI .opencode/env.sh al .gitignore del tuo repo!

export MDB_MCP_CONNECTION_STRING="mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# Oppure connessione locale:
# export MDB_MCP_CONNECTION_STRING="mongodb://localhost:27017/dbname"
